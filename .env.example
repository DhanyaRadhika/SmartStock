PORT=3000
MONGODB_URI=mongodb://127.0.0.1:val/smartstock
SESSION_SECRET=change-me
CLIENT_ORIGIN=http://localhost:value
# Replace the values below with your own credentials before running the server.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# For local development use: http://localhost:value/api/auth/google/callback
# For production set your real app URL below and register it in Google Cloud
GOOGLE_CALLBACK_URL=https://your-production-domain.com/api/auth/google/callback
# Admin account: provide email and scrypt-format hash (or use ADMIN_PASSWORD_PLAIN for local dev only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$<salt-base64>$<hash-base64>